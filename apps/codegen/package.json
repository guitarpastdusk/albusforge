{
  "name": "@albusforge/codegen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/job.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/job.js --external:pg-native \"--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@albusforge/db": "workspace:*",
    "@albusforge/schema": "workspace:*",
    "google-auth-library": "^11.0.2",
    "zod": "~4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "esbuild": "~0.28.2",
    "eslint": "^9.39.5",
    "pg": "^8.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "exports": {
    "./candidate": "./src/candidate.ts",
    "./artifacts": "./src/artifacts.ts",
    "./plan": "./src/plan.ts",
    "./worker": "./src/job.ts",
    "./compiler": "./src/compiler.ts"
  }
}
