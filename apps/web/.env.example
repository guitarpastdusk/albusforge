# Copy to .env.local for local overrides. `pnpm dev` already works with no
# setup: the committed .env.development sets API_MODE=mock for `next dev` only.

# Where server-side data comes from.
#   live — call gateway at GATEWAY_INTERNAL_URL (the default when unset)
#   mock — resolve every API call from src/mocks (no gateway needed)
# The server refuses to start with API_MODE=mock on Cloud Run (K_SERVICE set).
# Read at request time, so one image serves staging and prod.
API_MODE=mock

# Gateway's internal run.app URL. Server-side code calls this directly over the
# VPC — never the public domain, which would exit through Cloud NAT and put
# every user behind one IP at Cloud Armor (docs/adr/0007). It is also the
# audience of the ID token sent as X-Albus-Internal-Auth. Browser code always
# calls relative /v1/..., which the load balancer routes to gateway.
GATEWAY_INTERNAL_URL=http://localhost:8081

# The public apex this environment serves: albusforge.ai in prod,
# staging.albusforge.ai in staging. A Host equal to it is the apex; a Host one
# label longer is a tenant subdomain.
PUBLIC_DOMAIN=localhost

# How SSR authenticates to gateway in live mode.
#   metadata — Google-signed ID token from the Cloud Run metadata server (default)
#   none     — no token; for a gateway running locally without internal auth
GATEWAY_INTERNAL_AUTH=none

# X-Forwarded-For entries appended by trusted proxies after the client, skipped
# from the right to find the visitor IP sent as X-Albus-Client-IP. Default 1:
# only the load balancer's own IP. A non-negative integer; anything else fails
# startup. The infra session verifies this on staging and sets it through
# Terraform only if 1 turns out to be wrong.
TRUSTED_PROXY_HOPS=1
