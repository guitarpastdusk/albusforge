{
  "name": "@albusforge/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-migrations.mjs",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsc -p tsconfig.build.json && node dist/migrate.js"
  },
  "dependencies": {
    "drizzle-orm": "~0.45.2",
    "pg": "^8.23.0",
    "zod": "~4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "~0.31.10",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
