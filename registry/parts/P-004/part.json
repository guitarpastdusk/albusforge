{
  "$schema": "../../schemas/part.schema.json",
  "id": "P-004",
  "version": "1.0.0",
  "name": "MPU-6050 6-DoF Accelerometer and Gyroscope",
  "category": "physical",
  "status": "draft",
  "successor": null,
  "electrical": {
    "interface": "i2c",
    "connector": "hsx-i2c-4pin-v1",
    "voltage_range": [3.0, 5.0],
    "current_draw_ma": { "idle": 0.005, "active": 3.8 },
    "requires": ["bus.i2c"],
    "conflicts": [],
    "i2c_address": "0x68"
  },
  "mechanical": {
    "footprint_file": "footprint.step",
    "bounding_mm": [26.0, 17.8, 4.6],
    "mount": { "type": "unspecified" },
    "exposure": "none",
    "environment_flags": ["temp:-40..85C"]
  },
  "software": {
    "driver_pkg": "hsx-driver-mpu6050",
    "driver_version": "0.1.0",
    "sdk_module": "sensors/motion",
    "capabilities": ["read.acceleration_g", "read.angular_rate_dps"],
    "min_runtime": ">=0.1.0"
  },
  "cloud": {
    "telemetry_schema": "motion.v1",
    "default_widgets": ["line-chart"],
    "alert_templates": ["on_event"]
  },
  "commerce": {
    "suppliers": [{ "vendor": "adafruit", "sku": "3886", "url": "https://www.adafruit.com/product/3886" }],
    "unit_cost_usd": 12.95
  }
}
